<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>FG Cleaning | Professional Commercial Cleaning</title>

<meta name="description" content="FG Cleaning provides professional commercial cleaning services in San Antonio, Texas. Reliable cleaning solutions for offices, buildings and commercial spaces.">

<style>

:root{

  --blue:#1267d6;

  --dark:#071b3a;

  --navy:#0b2145;

  --light:#f5f8fc;

  --gray:#64748b;

  --white:#ffffff;

}

*{

  box-sizing:border-box;

  margin:0;

  padding:0;

}

html{

  scroll-behavior:smooth;

}

body{

  font-family:Arial, Helvetica, sans-serif;

  color:var(--dark);

  background:white;

  line-height:1.6;

}

a{

  text-decoration:none;

  color:inherit;

}

.container{

  width:90%;

  max-width:1150px;

  margin:auto;

}

/* HEADER */

header{

  background:white;

  border-bottom:1px solid #e7edf5;

  position:sticky;

  top:0;

  z-index:1000;

}

.nav{

  height:86px;

  display:flex;

  align-items:center;

  justify-content:space-between;

}

.logo{

  height:68px;

  width:auto;

}

.nav-links{

  display:flex;

  align-items:center;

  gap:34px;

  font-weight:700;

  color:var(--dark);

}

.nav-links a:hover{

  color:var(--blue);

}

.quote-btn{

  background:var(--blue);

  color:white;

  padding:13px 24px;

  border-radius:7px;

  font-weight:800;

  transition:.2s;

}

.quote-btn:hover{

  background:#0b55b5;

  transform:translateY(-1px);

}

/* HERO */

.hero{

  background:

    linear-gradient(90deg,rgba(7,27,58,.96),rgba(7,27,58,.82)),

    url('FGcleaning logo.pgn.png');

  background-size:cover;

  background-position:center;

  min-height:610px;

  display:flex;

  align-items:center;

  color:white;

}

.hero-content{

  display:grid;

  grid-template-columns:1.1fr .9fr;

  gap:60px;

  align-items:center;

}

.hero-text{

  max-width:650px;

}

.eyebrow{

  color:#54a0ff;

  font-weight:800;

  letter-spacing:2px;

  font-size:15px;

  margin-bottom:15px;

}

.hero h1{

  font-size:58px;

  line-height:1.05;

  margin-bottom:24px;

}

.hero h1 span{

  color:#1e78ed;

}

.hero p{

  font-size:20px;

  color:#dce8f8;

  margin-bottom:32px;

  max-width:610px;

}

.hero-buttons{

  display:flex;

  gap:15px;

  flex-wrap:wrap;

}

.primary-btn{

  background:var(--blue);

  color:white;

  padding:16px 28px;

  border-radius:7px;

  font-weight:800;

}

.secondary-btn{

  border:2px solid white;

  color:white;

  padding:14px 27px;

  border-radius:7px;

  font-weight:800;

}

.secondary-btn:hover{

  background:white;

  color:var(--dark);

}

.hero-logo{

  background:white;

  border-radius:15px;

  padding:25px;

  box-shadow:0 20px 50px rgba(0,0,0,.25);

}

.hero-logo img{

  width:100%;

  display:block;

}

/* SERVICES */

section{

  padding:90px 0;

}

.section-title{

  text-align:center;

  max-width:700px;

  margin:0 auto 55px;

}

.section-title .eyebrow{

  margin-bottom:8px;

}

.section-title h2{

  font-size:42px;

  margin-bottom:12px;

}

.section-title p{

  color:var(--gray);

  font-size:17px;

}

.services{

  background:var(--light);

}

.cards{

  display:grid;

  grid-template-columns:repeat(3,1fr);

  gap:25px;

}

.card{

  background:white;

  padding:35px;

  border-radius:12px;

  border:1px solid #e5ebf3;

  box-shadow:0 8px 25px rgba(7,27,58,.06);

}

.card-icon{

  width:55px;

  height:55px;

  border-radius:10px;

  background:#e8f2ff;

  color:var(--blue);

  display:flex;

  align-items:center;

  justify-content:center;

  font-size:25px;

  margin-bottom:20px;

}

.card h3{

  font-size:22px;

  margin-bottom:10px;

}

.card p{

  color:var(--gray);

}

/* ABOUT */

.about{

  background:white;

}

.about-grid{

  display:grid;

  grid-template-columns:1fr 1fr;

  gap:70px;

  align-items:center;

}

.about h2{

  font-size:42px;

  line-height:1.15;

  margin-bottom:20px;

}

.about p{

  color:var(--gray);

  margin-bottom:18px;

  font-size:17px;

}

.checks{

  margin-top:25px;

}

.check{

  margin-bottom:13px;

  font-weight:700;

}

.check span{

  color:var(--blue);

  margin-right:10px;

}

.about-box{

  background:var(--navy);

  color:white;

  padding:50px;

  border-radius:15px;

}

.about-box h3{

  font-size:28px;

  margin-bottom:15px;

}

.about-box p{

  color:#d9e6f7;

}

/* CTA */

.cta{

  background:linear-gradient(135deg,#0b2145,#1267d6);

  color:white;

  text-align:center;

}

.cta h2{

  font-size:42px;

  margin-bottom:15px;

}

.cta p{

  font-size:18px;

  color:#e2ecfa;

  max-width:700px;

  margin:0 auto 30px;

}

/* CONTACT */

.contact{

  background:var(--light);

}

.contact-grid{

  display:grid;

  grid-template-columns:1fr 1fr;

  gap:40px;

}

.contact-info{

  background:var(--navy);

  color:white;

  padding:45px;

  border-radius:14px;

}

.contact-info h2{

  font-size:34px;

  margin-bottom:15px;

}

.contact-info p{

  color:#dce8f8;

  margin-bottom:25px;

}

.contact-item{

  margin:18px 0;

}

.contact-item strong{

  display:block;

  color:#58a4ff;

}

.contact-form{

  background:white;

  padding:40px;

  border-radius:14px;

  box-shadow:0 8px 25px rgba(7,27,58,.07);

}

.contact-form h3{

  font-size:28px;

  margin-bottom:20px;

}

input,

textarea{

  width:100%;

  padding:15px;

  border:1px solid #d8e1ec;

  border-radius:7px;

  margin-bottom:15px;

  font-family:inherit;

  font-size:16px;

}

textarea{

  min-height:130px;

  resize:vertical;

}

.submit-btn{

  width:100%;

  border:0;

  background:var(--blue);

  color:white;

  padding:16px;

  border-radius:7px;

  font-size:16px;

  font-weight:800;

  cursor:pointer;

}

/* FOOTER */

footer{

  background:#06152d;

  color:white;

  padding:30px 0;

}

.footer-content{

  display:flex;

  justify-content:space-between;

  align-items:center;

  gap:20px;

}

.footer-logo{

  height:55px;

  background:white;

  border-radius:5px;

  padding:5px;

}

footer p{

  color:#aebdd0;

  font-size:14px;

}

/* MOBILE */

@media(max-width:850px){

  .nav{

    height:auto;

    padding:15px 0;

    flex-wrap:wrap;

    gap:15px;

  }

  .logo{

    height:55px;

  }

  .nav-links{

    order:3;

    width:100%;

    justify-content:center;

    gap:18px;

    font-size:14px;

  }

  .hero{

    min-height:auto;

    padding:70px 0;

  }

  .hero-content{

    grid-template-columns:1fr;

    gap:40px;

  }

  .hero h1{

    font-size:43px;

  }

  .hero p{

    font-size:18px;

  }

  .cards{

    grid-template-columns:1fr;

  }

  .about-grid{

    grid-template-columns:1fr;

    gap:35px;

  }

  .contact-grid{

    grid-template-columns:1fr;

  }

  .section-title h2,

  .about h2,

  .cta h2{

    font-size:34px;

  }

  .footer-content{

    flex-direction:column;

    text-align:center;

  }

}

</style>

</head>

